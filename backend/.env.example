# AlgoMentor Backend Environment Variables
# Copy this file to .env and fill in the values

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server
PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (required in production).
# Native apps and server-to-server calls are unaffected. Leave empty in development
# to allow any origin.
# CORS_ORIGINS=https://app.algomentor.ai,http://localhost:8081

# Set to "true" only when the API runs behind exactly one reverse proxy/load
# balancer. This makes IP rate limiting use X-Forwarded-For. Do not enable when
# the API is directly internet-facing.
# TRUST_PROXY=true

# Durable local fallback store for attempts/revision when optional DB tables
# (migrations 003–005) have not been applied. Never commit learner data.
# LOCAL_STORE_PATH=./data/local-store.json

# AI Provider (Phase 3)
# GEMINI_API_KEY=your_gemini_api_key
